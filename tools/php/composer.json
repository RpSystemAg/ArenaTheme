{
	"name": "arena/quality-tools",
	"description": "Arena Commerce PHP quality gates (PHPCS, PHPStan, WPCompat).",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
		"johnbillion/wp-compat": "^1.4.0",
		"php-stubs/woocommerce-stubs": "^11.0",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1.0",
		"phpstan/extension-installer": "^1.4.0",
		"phpstan/phpstan": "^2.0.0",
		"squizlabs/php_codesniffer": "^3.12.0",
		"woocommerce/woocommerce-sniffs": "^1.0.1",
		"wp-coding-standards/wpcs": "^3.2.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"sort-packages": true,
		"optimize-autoloader": true
	}
}
