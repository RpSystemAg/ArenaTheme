				},
				{
					"name": "2xs",
					"slug": "30",
					"size": "0.45rem"
				},
				{
					"name": "xs",
					"slug": "40",
					"size": "0.675rem"
				},
				{
					"name": "sm",
					"slug": "50",
					"size": "0.9rem"
				},
				{
					"name": "md",
					"slug": "60",
					"size": "1.35rem"
				},
				{
					"name": "lg",
					"slug": "70",
					"size": "1.8rem"
				},
				{
					"name": "xl",
					"slug": "80",
					"size": "2.7rem"
				},
				{
					"name": "2xl",
					"slug": "90",
					"size": "3.6rem"
				},
				{
					"name": "3xl",
					"slug": "100",
					"size": "5.4rem"
				},
				{
					"name": "4xl",
					"slug": "110",
					"size": "7.2rem"
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"sm": "0px",
				"md": "0px",
				"lg": "0px",
				"xl": "0px",
				"full": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900"
				}
			}
