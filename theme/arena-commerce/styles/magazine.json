{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Magazine",
	"description": "Black-and-crimson newsstand energy: black-weight sans, zero radius, tight rhythm.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Canvas"
				},
				{
					"slug": "surface",
					"color": "#F7F7F8",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#EAECEE",
					"name": "Surface strong"
				},
				{
					"slug": "foreground",
					"color": "#111318",
					"name": "Ink"
				},
				{
					"slug": "muted",
					"color": "#4B5563",
					"name": "Ink muted"
				},
				{
					"slug": "primary",
					"color": "#A50034",
					"name": "Primary"
				},
				{
					"slug": "primary-hover",
					"color": "#7A0026",
					"name": "Primary hover"
				},
				{
					"slug": "accent",
					"color": "#B45309",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#FEF3E2",
