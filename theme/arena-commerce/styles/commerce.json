{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Commerce",
	"description": "High-contrast corporate blue for high-volume catalogues: compact density, small radius.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#FFFFFF",
					"name": "Canvas"
				},
				{
					"slug": "surface",
					"color": "#F5F7FA",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#E8EDF4",
					"name": "Surface strong"
				},
				{
					"slug": "foreground",
					"color": "#101828",
					"name": "Ink"
				},
				{
					"slug": "muted",
					"color": "#475467",
					"name": "Ink muted"
				},
				{
					"slug": "primary",
					"color": "#004EEB",
					"name": "Primary"
				},
				{
					"slug": "primary-hover",
					"color": "#0040B8",
					"name": "Primary hover"
				},
				{
					"slug": "accent",
					"color": "#B42318",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#FEE4E2",
					"name": "Accent soft"
				},
				{
					"slug": "success",
					"color": "#067647",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#B54708",
					"name": "Warning"
				},
				{
					"slug": "danger",
					"color": "#B42318",
					"name": "Danger"
				},
				{
					"slug": "border-strong",
					"color": "#667085",
					"name": "Border strong"
				},
				{
					"slug": "outline",
					"color": "#D0D5DD",
					"name": "Border"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
					"name": "Display",
					"slug": "display"
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
					"name": "Body",
					"slug": "body"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
					"name": "Mono",
					"slug": "mono"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "4xs",
					"slug": "10",
					"size": "0.106rem"
				},
				{
					"name": "3xs",
					"slug": "20",
					"size": "0.212rem"
				},
				{
					"name": "2xs",
					"slug": "30",
					"size": "0.425rem"
				},
				{
					"name": "xs",
					"slug": "40",
					"size": "0.637rem"
				},
				{
					"name": "sm",
					"slug": "50",
					"size": "0.85rem"
				},
				{
					"name": "md",
					"slug": "60",
					"size": "1.275rem"
				},
				{
					"name": "lg",
					"slug": "70",
					"size": "1.7rem"
				},
				{
					"name": "xl",
					"slug": "80",
					"size": "2.55rem"
				},
				{
					"name": "2xl",
					"slug": "90",
					"size": "3.4rem"
				},
				{
					"name": "3xl",
					"slug": "100",
					"size": "5.1rem"
				},
				{
					"name": "4xl",
					"slug": "110",
					"size": "6.8rem"
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"sm": "4px",
				"md": "8px",
				"lg": "12px",
				"xl": "16px",
				"full": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			}
		}
	}
}
