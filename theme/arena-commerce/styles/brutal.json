{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Brutal",
	"description": "Highlighter-yellow poster energy: mono headings, zero radius, dense grid.",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#FFEB00",
					"name": "Highlighter"
				},
				{
					"slug": "surface",
					"color": "#FFF350",
					"name": "Surface"
				},
				{
					"slug": "surface-alt",
					"color": "#F5D900",
					"name": "Surface strong"
				},
				{
					"slug": "foreground",
					"color": "#0A0A0A",
					"name": "Ink"
				},
				{
					"slug": "muted",
					"color": "#4A4A00",
					"name": "Ink muted"
				},
				{
					"slug": "primary",
					"color": "#0A0A0A",
					"name": "Primary"
				},
				{
					"slug": "primary-hover",
					"color": "#262626",
					"name": "Primary hover"
				},
				{
					"slug": "accent",
					"color": "#7A0000",
					"name": "Accent"
				},
				{
					"slug": "accent-soft",
					"color": "#F5D900",
					"name": "Accent soft"
				},
				{
					"slug": "success",
					"color": "#0B6B2E",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#7A4A00",
					"name": "Warning"
				},
				{
					"slug": "danger",
					"color": "#8B0000",
					"name": "Danger"
				},
				{
					"slug": "border-strong",
					"color": "#3A3A00",
					"name": "Border strong"
				},
				{
					"slug": "outline",
					"color": "#B8A800",
					"name": "Border"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
					"name": "Display",
					"slug": "display"
				},
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
					"name": "Body",
					"slug": "body"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
					"name": "Mono",
					"slug": "mono"
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "4xs",
					"slug": "10",
					"size": "0.1rem"
				},
				{
					"name": "3xs",
					"slug": "20",
					"size": "0.2rem"
				},
				{
					"name": "2xs",
					"slug": "30",
					"size": "0.4rem"
				},
				{
					"name": "xs",
					"slug": "40",
					"size": "0.6rem"
				},
				{
					"name": "sm",
					"slug": "50",
					"size": "0.8rem"
				},
				{
					"name": "md",
					"slug": "60",
					"size": "1.2rem"
				},
				{
					"name": "lg",
					"slug": "70",
					"size": "1.6rem"
				},
				{
					"name": "xl",
					"slug": "80",
					"size": "2.4rem"
				},
				{
					"name": "2xl",
					"slug": "90",
					"size": "3.2rem"
				},
				{
					"name": "3xl",
					"slug": "100",
					"size": "4.8rem"
				},
				{
					"name": "4xl",
					"slug": "110",
					"size": "6.4rem"
				}
			]
		},
		"custom": {
			"radius": {
				"none": "0",
				"sm": "0px",
				"md": "0px",
				"lg": "0px",
				"xl": "0px",
				"full": "999px"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700"
				}
			}
		}
	}
}
