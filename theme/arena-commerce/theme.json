					"name": "Display small",
					"size": "2.25rem",
					"slug": "3xl"
				},
				{
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					},
					"name": "Display medium",
					"size": "3rem",
					"slug": "4xl"
				},
				{
					"fluid": {
						"min": "2.25rem",
						"max": "4rem"
					},
					"name": "Display large",
					"size": "4rem",
					"slug": "5xl"
				},
				{
					"fluid": {
						"min": "2.5rem",
						"max": "5rem"
					},
					"name": "Display huge",
					"size": "5rem",
					"slug": "6xl"
				},
				{
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					},
					"name": "Price",
					"size": "1.25rem",
					"slug": "price"
				},
				{
					"fluid": {
						"min": "1.25rem",
						"max": "1.75rem"
					},
					"name": "Quote",
					"size": "1.5rem",
					"slug": "quote"
				},
				{
					"fluid": {
						"min": "0.75rem",
						"max": "0.8125rem"
					},
					"name": "Caption",
					"size": "0.8125rem",
					"slug": "caption"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					},
					"name": "CTA",
					"size": "1rem",
					"slug": "cta"
				},
				{
					"fluid": {
						"min": "0.8125rem",
						"max": "0.875rem"
					},
					"name": "Post meta",
					"size": "0.875rem",
					"slug": "meta"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"readingMode": false,
			"textColumns": true,
			"textDecoration": true,
			"textIndent": true,
			"textShadow": true,
			"textTransform": true,
			"writingMode": true
		},
		"spacing": {
			"blockGap": true,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"spacingSizes": [
				{
					"name": "4xs",
					"size": "0.125rem",
					"slug": "10"
				},
				{
					"name": "3xs",
					"size": "0.25rem",
					"slug": "20"
				},
				{
					"name": "2xs",
					"size": "0.5rem",
					"slug": "30"
				},
				{
					"name": "xs",
					"size": "0.75rem",
					"slug": "40"
				},
				{
					"name": "sm",
					"size": "1rem",
					"slug": "50"
				},
				{
					"name": "md",
					"size": "1.5rem",
					"slug": "60"
				},
				{
					"name": "lg",
					"size": "2rem",
					"slug": "70"
				},
				{
					"name": "xl",
					"size": "3rem",
					"slug": "80"
				},
				{
					"name": "2xl",
					"size": "4rem",
					"slug": "90"
				},
				{
					"name": "3xl",
					"size": "6rem",
					"slug": "100"
				},
				{
					"name": "4xl",
					"size": "8rem",
					"slug": "110"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"layout": {
			"allowCustomContentAndWideSize": true,
			"allowEditing": true,
			"contentSize": "46rem",
			"wideSize": "77.5rem"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"defaultSizes": false,
			"minHeight": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Hairline",
					"shadow": "0 1px 2px 0 rgb(11 16 23 / 0.06)",
					"slug": "hairline"
				},
				{
					"name": "Card",
					"shadow": "0 2px 8px -2px rgb(11 16 23 / 0.10), 0 1px 2px 0 rgb(11 16 23 / 0.06)",
					"slug": "card"
				},
				{
					"name": "Raised",
					"shadow": "0 8px 24px -8px rgb(11 16 23 / 0.16), 0 2px 6px -2px rgb(11 16 23 / 0.08)",
					"slug": "raised"
				},
				{
					"name": "Overlay",
					"shadow": "0 24px 48px -12px rgb(11 16 23 / 0.28)",
					"slug": "overlay"
				},
				{
					"name": "Focus ring",
					"shadow": "0 0 0 3px var(--wp--preset--color--base), 0 0 0 6px var(--wp--preset--color--primary)",
					"slug": "focus"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"color": true,
					"radius": true,
					"style": true,
					"width": true
				},
				"color": {
					"background": true,
					"gradients": true,
					"text": true
				},
				"shadow": "all",
				"spacing": {
					"margin": true,
					"padding": true
				},
				"typography": {
					"fontSize": true,
					"fontWeight": true,
					"letterSpacing": true,
					"textTransform": true
				}
			},
			"core/group": {
				"background": {
					"backgroundImage": true,
					"backgroundSize": true
				},
				"border": {
					"color": true,
					"radius": true,
					"style": true,
					"width": true
				},
				"shadow": "all"
			},
			"core/image": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				}
			},
			"core/navigation": {
				"color": {
					"text": true
				},
				"spacing": {
					"blockGap": true
				},
				"typography": {
					"fontSize": true,
					"fontWeight": true
				}
			},
			"core/navigation-link": {
				"color": {
					"text": true
				},
				"typography": {
					"fontSize": true,
					"fontWeight": true,
					"textDecoration": true
				}
			},
			"core/site-title": {
				"border": {
					"color": true,
					"radius": true,
					"style": true,
					"width": true
				},
				"color": {
					"text": true
				},
				"typography": {
					"fontFamily": true,
					"fontSize": true,
					"fontWeight": true,
					"letterSpacing": true,
					"lineHeight": true,
					"textDecoration": true,
					"textTransform": true
				}
			}
		},
		"custom": {
			"easing": {
				"emphasized": "cubic-bezier(0.2, 0, 0, 1)",
				"exit": "cubic-bezier(0.4, 0, 1, 1)",
				"spring": "linear(0, 0.006, 0.025 2.8%, 0.101 6.1%, 0.539 18.9%, 0.721 25.3%, 0.849 31.5%, 0.937 38.1%, 0.968 41.8%, 0.991 45.7%, 1.006 50.1%, 1.015 55%, 1.017 63.9%, 1.001 89.2%, 1)",
				"standard": "cubic-bezier(0.2, 0, 0, 1)"
			},
			"motion": {
				"duration-fast": "150ms",
				"duration-medium": "300ms",
				"duration-slow": "500ms"
			},
			"radius": {
				"full": "999px",
				"lg": "1rem",
				"md": "0.75rem",
				"none": "0",
				"sm": "0.375rem",
				"xl": "1.5rem"
			},
			"spacing": {
				"gap": "1.5rem",
				"gutter": "clamp(1rem, 4vw, 2rem)",
				"outer": "clamp(1rem, 5vw, 3rem)"
			},
			"fontWeight": {
				"black": 900,
				"bold": 700,
				"extrabold": 800,
				"light": 300,
				"medium": 500,
				"regular": 400,
				"semibold": 600
			},
			"lineHeight": {
				"body": 1.65,
				"heading": 1.12,
				"medium": 1.4,
				"tiny": 1.1
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--custom--spacing--outer)",
				"right": "var(--wp--custom--spacing--outer)"
			}
		},
		"elements": {
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--md)",
					"width": "0"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"shadow": "var(--wp--preset--shadow--hairline)",
				"spacing": {
					"padding": {
						"bottom": "0.875rem",
						"left": "1.5rem",
						"right": "1.5rem",
						"top": "0.875rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--cta)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--base)"
					},
					"shadow": "var(--wp--preset--shadow--card)"
				},
				":focus-visible": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--base)"
					},
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--base)"
					},
					"shadow": "none"
				},
				"@mobile": {
					"spacing": {
						"padding": {
							"bottom": "1rem",
							"left": "1.25rem",
							"right": "1.25rem",
							"top": "1rem"
						}
					},
					"typography": {
						"fontSize": "var(--wp--preset--font-size--sm)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"spacing": {
					"margin": {
						"top": "0.5rem"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--5xl)",
					"fontWeight": "800",
					"letterSpacing": "-0.03em",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--4xl)",
					"fontWeight": "800",
					"letterSpacing": "-0.025em",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3xl)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2xl)",
					"fontWeight": "700",
					"letterSpacing": "-0.015em",
					"lineHeight": "var(--wp--custom--line-height--medium)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--lg)",
					"fontWeight": "600",
					"letterSpacing": "0.01em",
					"lineHeight": "var(--wp--custom--line-height--medium)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--foreground)"
				},
				"spacing": {
					"margin": {
						"bottom": "0.5em",
						"top": "0"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-hover)"
					},
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "3px",
						"style": "solid",
						"width": "3px"
					}
				},
				"@mobile": {
					"typography": {
						"fontSize": "var(--wp--preset--font-size--sm)"
					}
				},
				"variations": {
					"outline": {
						"border": {
							"color": "var(--wp--preset--color--border-strong)",
							"width": "2px"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--primary)"
						},
						"shadow": "none",
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--primary)",
								"text": "var(--wp--preset--color--base)"
							}
						}
					}
				}
			},
			"core/navigation-link": {
				"typography": {
					"fontWeight": "500",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "3px"
					}
				},
				"-current": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"fontWeight": "700"
					}
				}
			},
			"core/comment-author-name": {
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--foreground)"
						},
						"typography": {
							"fontWeight": "600",
							"textDecoration": "none"
						}
					}
				}
			},
			"core/comment-content": {
				"spacing": {
					"margin": {
						"bottom": "1.5rem",
						"top": "1.5rem"
					}
				}
			},
			"core/comment-date": {
				"color": {
