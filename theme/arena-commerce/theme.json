				},
				{
					"color": "#0B1017",
					"name": "Ink",
					"slug": "foreground"
				},
				{
					"color": "#55606F",
					"name": "Ink muted",
					"slug": "muted"
				},
				{
					"color": "#0B4F6C",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#08394F",
					"name": "Primary hover",
					"slug": "primary-hover"
				},
				{
					"color": "#B45309",
					"name": "Accent",
					"slug": "accent"
				},
				{
					"color": "#FEF3E2",
					"name": "Accent soft",
					"slug": "accent-soft"
				},
				{
					"color": "#15803D",
					"name": "Success",
					"slug": "success"
				},
				{
					"color": "#A16207",
					"name": "Warning",
					"slug": "warning"
				},
				{
					"color": "#B91C1C",
					"name": "Danger",
					"slug": "danger"
				},
				{
					"color": "#6B7480",
					"name": "Border strong",
					"slug": "border-strong"
				},
				{
					"color": "#C6CBD3",
					"name": "Border",
					"slug": "outline"
