				{
					"fontFamily": "ui-serif, Georgia, Cambria, \"Times New Roman\", serif",
					"name": "System Serif",
					"slug": "system-serif"
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"min": "0.75rem",
						"max": "0.8125rem"
					},
					"name": "Extra small",
