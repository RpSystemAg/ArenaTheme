					"name": "Medium",
					"size": "1rem",
					"slug": "md"
				},
				{
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					},
					"name": "Large",
					"size": "1.1875rem",
					"slug": "lg"
				},
				{
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					},
					"name": "Extra large",
					"size": "1.375rem",
					"slug": "xl"
				},
				{
