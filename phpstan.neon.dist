parameters:
	level: 6
	paths:
		- %currentWorkingDirectory%/theme/arena-commerce
		- %currentWorkingDirectory%/plugin/arena-engine
	tmpDir: %currentWorkingDirectory%/tools/php/.phpstan-cache
	excludePaths:
		analyse:
			- %currentWorkingDirectory%/tests
			- %currentWorkingDirectory%/tools
			- %currentWorkingDirectory%/dist
	scanFiles:
		- %currentWorkingDirectory%/tools/php/vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- %currentWorkingDirectory%/tools/php/vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	bootstrapFiles:
		- %currentWorkingDirectory%/tools/php/phpstan-bootstrap.php
	reportUnmatchedIgnoredErrors: false
	WPCompat:
		requiresAtLeast: '6.9'
