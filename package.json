{
	"name": "arena-commerce-quality",
	"version": "3.1.0",
	"private": true,
	"description": "Quality gate tooling for the Arena Prime v3.1 WordPress stack.",
	"scripts": {
		"lint:js": "eslint .",
		"test": "npm run test:quality && npm run test:e2e",
		"test:quality": "npm run test:anti-clone && npm run test:axe && npm run test:billboard && npm run test:family && npm run test:flip && npm run test:mobilenav && npm run test:lighthouse-budget && npm run test:kits && npm run test:purchase && npm run test:rtl && npm run test:i18n && npm run test:panel && npm run test:presets && npm run test:jsonld && npm run test:assets && npm run test:dark && npm run test:child",
		"test:anti-clone": "node tests/anti-clone.mjs",
		"test:axe": "node tests/axe-static.test.mjs",
		"test:billboard": "node tests/h14-billboard.test.mjs",
		"test:family": "node tests/h15-family-system.test.mjs",
		"test:flip": "node tests/h11-flip.test.mjs",
		"test:mobilenav": "node tests/h2-mobilenav.test.mjs",
		"test:lighthouse-budget": "node tests/lighthouse-budget.test.mjs",
		"test:lighthouse-real": "node tests/lighthouse-run.mjs",
		"test:e2e": "playwright test",
		"build:dist": "node tools/build-dists.mjs",
		"wp-env": "wp-env",
		"test:kits": "node tests/g8-kits.test.mjs",
		"test:purchase": "node tests/g9-purchase-flow.test.mjs",
		"test:rtl": "node tests/g10-rtl.test.mjs",
		"test:i18n": "node tests/g11-i18n.test.mjs",
		"test:panel": "node tests/g12-panel-undo.test.mjs",
		"test:presets": "node tests/g13-presets.test.mjs",
		"test:jsonld": "node tests/g14-jsonld.test.mjs",
		"test:assets": "node tests/g15-assets.test.mjs",
		"test:dark": "node tests/g16-dark.test.mjs",
		"test:child": "node tests/g17-child-starter.test.mjs",
		"make:pot": "node tools/make-pot.mjs",
		"make:pot:check": "node tools/make-pot.mjs --check",
		"build:kits": "node tools/build-kits.mjs",
		"build:rtl": "node tools/build-rtl.mjs",
		"build:presets": "node tools/build-presets.mjs",
		"build:diagrams": "node tools/build-doc-diagrams.mjs"
	},
	"devDependencies": {
		"@babel/core": "^7.28.0",
		"@playwright/test": "^1.62.1",
		"@woocommerce/eslint-plugin": "^4.0.0",
		"@wordpress/env": "^11.14.0",
		"@wordpress/eslint-plugin": "^25.10.0",
		"@wordpress/interactivity": "^6.54.0",
		"eslint": "^9.22.0",
		"jest": "^30.5.0",
		"prettier": "^3.6.0",
		"typescript": "^5.8.0"
	}
}
